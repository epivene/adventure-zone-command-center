{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f3f5f0" },
      "foreground": { "$value": "#173b48" },
      "border": { "$value": "#d8e2dd" },
      "card": { "$value": "#fbfcf8" },
      "cardForeground": { "$value": "#173b48" },
      "popover": { "$value": "#fbfcf8" },
      "popoverForeground": { "$value": "#173b48" },
      "primary": {
        "$value": "#d51352",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#fff7fa" },
      "secondary": { "$value": "#fde7ef" },
      "secondaryForeground": { "$value": "#8e123f" },
      "muted": { "$value": "#f8f0f3" },
      "mutedForeground": { "$value": "#71848a" },
      "accent": { "$value": "#d4874f" },
      "accentForeground": { "$value": "#fffaf3" },
      "destructive": { "$value": "#b8544f" },
      "destructiveForeground": { "$value": "#fffaf3" },
      "input": { "$value": "#cad9d3" },
      "ring": { "$value": "#e54878" },
      "chart1": { "$value": "#d51352" },
      "chart2": { "$value": "#d4874f" },
      "chart3": { "$value": "#315b66" },
      "chart4": { "$value": "#9ab6a9" },
      "chart5": { "$value": "#d9b57b" },
      "sidebar": { "$value": "#173b48" },
      "sidebarForeground": { "$value": "#f8f5ee" },
      "sidebarBorder": { "$value": "#315b66" },
      "sidebarPrimary": { "$value": "#d51352" },
      "sidebarPrimaryForeground": { "$value": "#fff7fa" },
      "sidebarAccent": { "$value": "#641634" },
      "sidebarAccentForeground": { "$value": "#f8f5ee" },
      "sidebarRing": { "$value": "#ef6b96" }
    },
    "dark": {
      "background": { "$value": "#10242b" },
      "foreground": { "$value": "#f3f5f0" },
      "border": { "$value": "#2d4a51" },
      "card": { "$value": "#162f37" },
      "cardForeground": { "$value": "#f3f5f0" },
      "popover": { "$value": "#193740" },
      "popoverForeground": { "$value": "#f3f5f0" },
      "primary": { "$value": "#ef6b96" },
      "primaryForeground": { "$value": "#300817" },
      "secondary": { "$value": "#4f1b32" },
      "secondaryForeground": { "$value": "#ffd9e5" },
      "muted": { "$value": "#2a2028" },
      "mutedForeground": { "$value": "#a7bbb4" },
      "accent": { "$value": "#e0a06c" },
      "accentForeground": { "$value": "#10242b" },
      "destructive": { "$value": "#e07a72" },
      "destructiveForeground": { "$value": "#10242b" },
      "input": { "$value": "#35545a" },
      "ring": { "$value": "#ef6b96" },
      "chart1": { "$value": "#ef6b96" },
      "chart2": { "$value": "#e0a06c" },
      "chart3": { "$value": "#8bb3bf" },
      "chart4": { "$value": "#a7bbb4" },
      "chart5": { "$value": "#d9b57b" },
      "sidebar": { "$value": "#0d1d23" },
      "sidebarForeground": { "$value": "#f3f5f0" },
      "sidebarBorder": { "$value": "#29434b" },
      "sidebarPrimary": { "$value": "#ef6b96" },
      "sidebarPrimaryForeground": { "$value": "#300817" },
      "sidebarAccent": { "$value": "#4f1b32" },
      "sidebarAccentForeground": { "$value": "#fff0f5" },
      "sidebarRing": { "$value": "#f28bae" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Warm, legible UI and body typeface from the CRM profile source."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Geist Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.625rem",
      "$description": "Soft but controlled radius; cards and record surfaces use larger derived steps."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-point spacing rhythm used for compact CRM density and clear grouping."
    }
  }
}
