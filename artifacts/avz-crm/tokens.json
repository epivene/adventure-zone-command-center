{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fff7fa" },
      "foreground": { "$value": "#17110f" },
      "border": { "$value": "#e4c7d2" },
      "card": { "$value": "#fffdfb" },
      "cardForeground": { "$value": "#17110f" },
      "popover": { "$value": "#fffdfb" },
      "popoverForeground": { "$value": "#17110f" },
      "primary": {
        "$value": "#d11a56",
        "$description": "Flyer-derived carnival magenta. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#f2dce6" },
      "secondaryForeground": { "$value": "#73143a" },
      "muted": { "$value": "#faf0f4" },
      "mutedForeground": { "$value": "#69565f" },
      "accent": { "$value": "#f7c70b" },
      "accentForeground": { "$value": "#17110f" },
      "destructive": { "$value": "#b14237" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d9b5c3" },
      "ring": { "$value": "#d11a56" },
      "chart1": { "$value": "#d11a56" },
      "chart2": { "$value": "#f7c70b" },
      "chart3": { "$value": "#1558ae" },
      "chart4": { "$value": "#da235b" },
      "chart5": { "$value": "#d09764" },
      "sidebar": { "$value": "#080706" },
      "sidebarForeground": { "$value": "#fff7e8" },
      "sidebarBorder": { "$value": "#4d352b" },
      "sidebarPrimary": { "$value": "#d11a56" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#56122d" },
      "sidebarAccentForeground": { "$value": "#fff7e8" },
      "sidebarRing": { "$value": "#f7c70b" }
    },
    "dark": {
      "background": { "$value": "#100a0d" },
      "foreground": { "$value": "#fff7e8" },
      "border": { "$value": "#4d2634" },
      "card": { "$value": "#1c1117" },
      "cardForeground": { "$value": "#fff7e8" },
      "popover": { "$value": "#24151d" },
      "popoverForeground": { "$value": "#fff7e8" },
      "primary": { "$value": "#ef3a77" },
      "primaryForeground": { "$value": "#1a080f" },
      "secondary": { "$value": "#4a1830" },
      "secondaryForeground": { "$value": "#ffdce7" },
      "muted": { "$value": "#2b1c22" },
      "mutedForeground": { "$value": "#cfabb8" },
      "accent": { "$value": "#f7c70b" },
      "accentForeground": { "$value": "#17110f" },
      "destructive": { "$value": "#ef6b64" },
      "destructiveForeground": { "$value": "#1a080f" },
      "input": { "$value": "#633348" },
      "ring": { "$value": "#f7c70b" },
      "chart1": { "$value": "#ef3a77" },
      "chart2": { "$value": "#f7c70b" },
      "chart3": { "$value": "#5d91dc" },
      "chart4": { "$value": "#ff79a6" },
      "chart5": { "$value": "#e6aa75" },
      "sidebar": { "$value": "#050403" },
      "sidebarForeground": { "$value": "#fff7e8" },
      "sidebarBorder": { "$value": "#4d352b" },
      "sidebarPrimary": { "$value": "#ef3a77" },
      "sidebarPrimaryForeground": { "$value": "#1a080f" },
      "sidebarAccent": { "$value": "#4a1830" },
      "sidebarAccentForeground": { "$value": "#fff7e8" },
      "sidebarRing": { "$value": "#f7c70b" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Warm, legible UI and body typeface from the CRM profile source."
      },
      "display": {
        "$value": ["Impact", "Haettenschweiler", "Arial Narrow Bold", "sans-serif"],
        "$description": "Condensed display face for the flyer-inspired Adventure Zone brand voice."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Geist Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.625rem",
      "$description": "Soft but controlled radius; cards and record surfaces use larger derived steps."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-point spacing rhythm used for compact CRM density and clear grouping."
    }
  }
}
