{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "verify:act-preview": "pnpm --filter @workspace/scripts exec tsx verify-act-replacement-preview.ts",
    "report:act-import": "pnpm --filter @workspace/scripts exec tsx report-act-replacement-import.ts",
    "preview:business-documents": "pnpm --filter @workspace/scripts run preview:business-documents",
    "migrate:business-documents": "pnpm --filter @workspace/scripts run migrate:business-documents",
    "report:business-documents": "pnpm --filter @workspace/scripts run report:business-documents --",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
