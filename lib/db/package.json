{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./schema": "./src/schema/index.ts",
    "./event-family-schema": "./src/event-family-schema.ts",
    "./booking-assistant-schema": "./src/booking-assistant-schema.ts",
    "./paper-note-schema": "./src/paper-note-schema.ts",
    "./office-coordinator-schema": "./src/office-coordinator-schema.ts",
    "./google-workspace-schema": "./src/google-workspace-schema.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "push": "drizzle-kit push --config ./drizzle.config.ts && tsx ./src/run-migrations.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts && tsx ./src/run-migrations.ts",
    "run-migrations": "tsx ./src/run-migrations.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:"
  }
}
